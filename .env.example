# Configuracion de Entorno y Operacion
# Opciones para APP_ENV: development | production
APP_ENV=development
DEMO_MODE=true
TIMEZONE=America/Bogota

# Criptografia y Seguridad de Sesiones
# SECRET_KEY debe tener al menos 32 caracteres criptograficamente aleatorios.
# Generar en consola: openssl rand -hex 32
SECRET_KEY=clave_secreta_super_segura_de_al_menos_32_caracteres_minimo

# Control de Acceso CORS (Origenes permitidos separados por coma)
# Prohibido el uso de comodin '*' en entorno de produccion.
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Backend como Servicio (BaaS) - Supabase
# Obtener desde: Dashboard de Supabase -> Settings -> API
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_ANON_KEY=tu_clave_publica_anon_de_supabase_aqui
SUPABASE_SERVICE_ROLE_KEY=tu_clave_privada_service_role_de_supabase_aqui

# Inteligencia Artificial - Google Gemini API
# Obtener desde: Google AI Studio (https://aistudio.google.com/)
GEMINI_API_KEY=tu_clave_de_api_de_google_gemini_aqui
GEMINI_MODEL=gemini-2.5-flash

# Meta WhatsApp Cloud API (Numero de prueba de desarrollador)
# Obtener desde: Meta for Developers -> App Dashboard -> WhatsApp -> API Setup
WHATSAPP_TOKEN=tu_bearer_access_token_de_meta_aqui
WHATSAPP_PHONE_NUMBER_ID=100000000000001
WHATSAPP_VERIFY_TOKEN=token_personalizado_para_el_reto_de_verificacion_webhook
WHATSAPP_APP_SECRET=tu_app_secret_de_meta_para_validar_firma_sha256

# Tunel Seguro Cloudflare Tunnel (Opcional para conectar PC local con dominio publico)
# Obtener desde: Cloudflare Zero Trust -> Networks -> Tunnels
CLOUDFLARE_TUNNEL_TOKEN=tu_token_de_tunel_cloudflare_aqui
